{
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent & effect-tsgo patch --oxlint",
    "dev": "turbo run dev --filter=web",
    "dev:docs": "cd docs && mint dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "db:studio": "turbo run db:studio --filter=@patchsmith/db",
    "db:generate": "turbo run db:generate --filter=@patchsmith/db",
    "db:migrate": "turbo run db:migrate --filter=@patchsmith/db",
    "services:start": "docker compose up -d",
    "services:watch": "docker compose up",
    "services:stop": "docker compose stop",
    "services:down": "docker compose down",
    "check": "turbo run lint lint:root format",
    "fix": "turbo run lint:fix lint:root:fix && turbo run format:fix",
    "sherif": "sherif -r packages-without-package-json",
    "sherif:fix": "sherif -r packages-without-package-json --fix --select highest --no-install",
    "lint": "turbo run lint lint:root",
    "lint:fix": "turbo run lint:fix lint:root:fix",
    "lint:root": "vp lint . --ignore-pattern 'apps/**' --ignore-pattern 'packages/**' --ignore-pattern 'playground/**'",
    "lint:root:fix": "vp lint --fix . --ignore-pattern 'apps/**' --ignore-pattern 'packages/**' --ignore-pattern 'playground/**'",
    "format": "vp fmt --check",
    "format:fix": "vp fmt .",
    "licenses:sync": "node ./scripts/sync-licenses.mjs",
    "licenses:check": "node ./scripts/sync-licenses.mjs --check",
    "changeset": "vp exec changeset",
    "release:status": "vp exec changeset status --verbose",
    "release:version": "vp run release:check && vp exec changeset version && vp run release:check",
    "release:build": "turbo run build --filter=patchsmith --filter=@patchsmith/ai-sdk --filter=@patchsmith/app --filter=@patchsmith/app-db --filter=@patchsmith/vite --filter=@patchsmith/cli --filter=@patchsmith/client-core --filter=@patchsmith/client-platform --filter=@patchsmith/core --filter=@patchsmith/react --filter=@patchsmith/sandbox",
    "release:publish": "vp run release:check && vp run release:build && vp run release:check && vp exec changeset publish",
    "patchsmith": "vp -C packages/cli build && node ./packages/cli/dist/index.js",
    "playground:dev": "vp run playground:generate && vp -C playground/apps/todo run build && vp -C playground/tanstack-start run dev",
    "playground:db:push": "vp -C playground/shared run db:push",
    "playground:db:seed": "vp -C playground/shared run db:seed",
    "playground:build": "vp -C packages/ui run build && vp -C playground/tanstack-start run build && vp -C playground/apps/todo run build",
    "playground:schema:export": "vp -C packages/client-platform run build && vp -C packages/core run build && vp -C packages/patchsmith run build && vp -C playground/shared run schema:export",
    "playground:generate": "vp -C packages/client-platform run build && vp -C packages/core run build && vp -C packages/app-db run build && vp -C packages/app run build && vp -C packages/vite run build && vp -C packages/sandbox run build && vp -C packages/client-core run build && vp -C packages/react run build && vp -C packages/cli run build && vp -C packages/patchsmith run build && vp -C playground/shared run schema:export && vp -C playground/apps/todo run generate",
    "playground:todo:build": "vp -C playground/apps/todo run build",
    "release:check": "node ./scripts/check-prerelease.mjs",
    "test:release": "node --test ./scripts/check-prerelease.test.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@changesets/read": "1.0.1",
    "@effect/tsgo": "^0.53.3",
    "@shadcn/lint": "0.2.1",
    "mint": "^4.2.1059",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "sherif": "^1.13.0",
    "turbo": "2.11.9",
    "ultracite": "8.0.1",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.11"
  },
  "packageManager": "pnpm@12.11.2",
  "sherif": {
    "ignoreDependency": [
      "@ai-sdk/harness@1.0.148",
      "@ai-sdk/sandbox-vercel@1.0.148",
      "@ai-sdk/workflow-harness@1.0.148",
      "ai@7.0.143",
      "@ai-sdk/harness@1.0.154",
      "@ai-sdk/sandbox-vercel@1.0.154"
    ]
  }
}
