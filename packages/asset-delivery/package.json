{
  "name": "@patchsmith/asset-delivery",
  "version": "0.0.0",
  "private": true,
  "license": "BUSL-1.1",
  "type": "module",
  "imports": {
    "#env": "./src/env.ts",
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "exports": {
    "./static-assets": {
      "development": "./src/static-assets.ts",
      "types": "./dist/static-assets.d.mts",
      "default": "./dist/static-assets.mjs"
    },
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./deployment-limits": {
      "development": "./src/deployment-limits.ts",
      "types": "./dist/deployment-limits.d.mts",
      "default": "./dist/deployment-limits.mjs"
    },
    "./logo-validation": {
      "development": "./src/logo-validation.ts",
      "types": "./dist/logo-validation.d.mts",
      "default": "./dist/logo-validation.mjs"
    }
  },
  "scripts": {
    "build": "vp pack src/index.ts src/deployment-limits.ts src/logo-validation.ts src/static-assets.ts --target node24 --format esm --dts --clean",
    "check-types": "tsc --noEmit",
    "test": "vp test run",
    "lint": "vp lint .",
    "lint:fix": "vp lint --fix ."
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@patchsmith/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.11"
  }
}
