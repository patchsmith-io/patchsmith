{
  "name": "@patchsmith/cli",
  "version": "0.1.0-beta.70",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patchsmith-io/patchsmith.git",
    "directory": "packages/cli"
  },
  "bin": {
    "patchsmith": "./bin/patchsmith.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "imports": {
    "#env": "./src/env.ts",
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ],
    "#package.json": "./package.json"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp build",
    "check-types": "tsc --noEmit",
    "test": "vp test run",
    "lint": "vp lint .",
    "lint:fix": "vp lint --fix ."
  },
  "dependencies": {
    "@ai-sdk/tui": "1.0.144",
    "@clack/prompts": "^1.8.1",
    "@orpc/client": "catalog:",
    "@patchsmith/client-platform": "workspace:*",
    "@patchsmith/core": "workspace:*",
    "@patchsmith/vite": "workspace:*",
    "ai": "catalog:",
    "cac": "^7.1.0",
    "get-tsconfig": "4.14.3",
    "jose": "6.2.12",
    "liquidjs": "^10.30.0",
    "picocolors": "^1.1.1",
    "valibot": "catalog:",
    "vite": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@patchsmith/app": "workspace:*",
    "@patchsmith/config": "workspace:*",
    "@types/node": "catalog:",
    "preact": "^11.0.1",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
