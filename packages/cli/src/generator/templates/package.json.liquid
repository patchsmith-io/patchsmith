{
  "name": "{{ packageName }}",
  "description": "A Patchsmith app that embeds in a host app to extend what it can do.",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "imports": {
    "#patchsmith": "./{{ sourcePrefix }}patchsmith.gen.ts",
    "#*": [
      "./{{ sourcePrefix }}*",
      "./{{ sourcePrefix }}*.ts",
      "./{{ sourcePrefix }}*.tsx",
      "./{{ sourcePrefix }}*/index.ts",
      "./{{ sourcePrefix }}*/index.tsx"
    ]
  },
  "scripts": {
    "build": "{% if vitePlus %}vp{% else %}vite{% endif %} build",
    "db:generate": "patchsmith db generate",
    "deploy": "patchsmith deploy",
    "generate": "patchsmith generate"{% if vitePlus %},
    "lint": "vp lint",
    "format": "vp fmt --check",
    "format:fix": "vp fmt",
    "check": "vp check",
    "fix": "vp check --fix",
    "test": "vp test"{% endif %}
  },
  "dependencies": {
    "patchsmith": "{{ patchsmithVersion }}",
    "preact": "{{ preactVersion }}",
    "valibot": "{{ valibotVersion }}"
  },
  "devDependencies": {
    "drizzle-kit": "{{ drizzleKitVersion }}",
    "drizzle-orm": "{{ drizzleOrmVersion }}",
    "typescript": "{{ typescriptVersion }}",
    "vite": "{% if vitePlus %}npm:@voidzero-dev/vite-plus-core@{{ vitePlusVersion }}{% else %}{{ viteVersion }}{% endif %}"{% if vitePlus %},
    "vite-plus": "{{ vitePlusVersion }}"{% endif %}
  },
  "type": "module"
}
