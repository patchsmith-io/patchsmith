{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": ["vite/client"],
    "verbatimModuleSyntax": true
  },
  "include": ["{{ sourceDirectory }}", "patchsmith.config.ts", "vite.config.ts"],
  "exclude": ["node_modules", ".patchsmith"]
}
