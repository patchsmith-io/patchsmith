import { defineView, useQuery } from "patchsmith/client";
import { api{% if useBox %}, Box{% endif %} } from "#patchsmith";
{% if multiple %}import * as v from "valibot";
{% endif %}

const view = defineView({
  view: {{ viewPath }},
{% if multiple %}  instances: {
    dataSchema: v.object({}),
    resolve: () => [{ key: "default", metadata: { title: "Default" }, data: {} }],
  },
{% endif %}
  component: ViewComponent,
});

function ViewComponent() {
  const greeting = useQuery(api.greeting.getGreeting, { name: "Patchsmith" });

  return <{% if useBox %}Box{% endif %}>{greeting.isLoading ? "Loading…" : greeting.error?.message ?? greeting.data}</{% if useBox %}Box{% endif %}>;
}

export default view;
