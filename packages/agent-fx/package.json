{
  "name": "@patchsmith/agent-fx",
  "version": "0.0.0",
  "private": true,
  "license": "BUSL-1.1",
  "type": "module",
  "imports": {
    "#env": "./src/env.ts",
    "#*": [
      "./src/*",
      "./src/*.ts"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./workflows": {
      "types": "./dist/workflows.d.mts",
      "import": "./src/workflows.ts"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs"
    }
  },
  "scripts": {
    "build": "vp pack src/index.ts src/workflows.ts src/server.ts --format esm --dts --clean",
    "check-types": "tsc --noEmit",
    "test": "vp test run",
    "lint": "vp lint .",
    "lint:fix": "vp lint --fix ."
  },
  "dependencies": {
    "@ai-sdk/harness": "1.0.164",
    "@ai-sdk/harness-fx": "1.0.80",
    "@ai-sdk/sandbox-vercel": "1.0.164",
    "@ai-sdk/workflow-harness": "1.0.164",
    "@patchsmith/db": "workspace:*",
    "@patchsmith/env": "workspace:*",
    "@vercel/oidc": "4.0.1",
    "@vercel/sandbox": "3.8.0",
    "ai": "catalog:fx",
    "drizzle-orm": "catalog:",
    "workflow": "5.2.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@patchsmith/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.11"
  }
}
