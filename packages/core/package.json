{
  "name": "@patchsmith/core",
  "version": "0.1.0-beta.68",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patchsmith-io/patchsmith.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#env": "./src/env.ts",
    "#*": {
      "development": [
        "./src/*",
        "./src/*.ts",
        "./src/*.tsx",
        "./src/*/index.ts",
        "./src/*/index.tsx"
      ],
      "types": [
        "./dist/*",
        "./dist/*.d.ts",
        "./dist/*/index.d.ts"
      ],
      "default": [
        "./src/*",
        "./src/*.ts",
        "./src/*.tsx",
        "./src/*/index.ts",
        "./src/*/index.tsx"
      ]
    }
  },
  "exports": {
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server.js"
    },
    "./server/types": {
      "types": "./dist/server/types.d.ts",
      "import": "./dist/server-types.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema.js"
    },
    "./spec": {
      "types": "./dist/spec/index.d.ts",
      "import": "./dist/spec.js"
    },
    "./primitives/theme": {
      "types": "./dist/primitives/theme.d.ts",
      "import": "./dist/primitives-theme.js"
    },
    "./primitives/zod": {
      "types": "./dist/primitives/zod.d.ts",
      "import": "./dist/primitives-zod.js"
    },
    "./primitives/valibot": {
      "types": "./dist/primitives/valibot.d.ts",
      "import": "./dist/primitives-valibot.js"
    },
    "./primitives/arktype": {
      "types": "./dist/primitives/arktype.d.ts",
      "import": "./dist/primitives-arktype.js"
    },
    "./views": {
      "types": "./dist/views.d.ts",
      "import": "./dist/views.js"
    },
    "./icons": {
      "types": "./dist/icons/definition.d.ts",
      "import": "./dist/icons-definition.js"
    },
    "./icons/zod": {
      "types": "./dist/icons/zod.d.ts",
      "import": "./dist/icons-zod.js"
    },
    "./icons/valibot": {
      "types": "./dist/icons/valibot.d.ts",
      "import": "./dist/icons-valibot.js"
    },
    "./icons/arktype": {
      "types": "./dist/icons/arktype.d.ts",
      "import": "./dist/icons-arktype.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "generate:native": "tsx scripts/generate-native-components/index.ts",
    "test": "vp test run --typecheck --exclude '**/*.test-d.ts'",
    "lint": "vp lint .",
    "lint:fix": "vp lint --fix .",
    "generate:icons": "node --import tsx scripts/generate-icon-names.ts"
  },
  "dependencies": {
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/experimental-effect": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@patchsmith/app": "workspace:*",
    "@patchsmith/client-platform": "workspace:*",
    "@standard-schema/spec": "^1.1.0",
    "effect": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@patchsmith/config": "workspace:*",
    "@types/node": "catalog:",
    "@valibot/to-json-schema": "^1.8.0",
    "ai": "catalog:",
    "arktype": "^2.2.8",
    "lucide-react": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "arktype": ">=2.1.0",
    "valibot": ">=1.0.0",
    "zod": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "arktype": {
      "optional": true
    },
    "valibot": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
