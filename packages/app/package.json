{
  "name": "@patchsmith/app",
  "version": "0.1.0-beta.70",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patchsmith-io/patchsmith.git",
    "directory": "packages/app"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#env": "./src/env.ts",
    "#*": {
      "development": [
        "./src/*",
        "./src/*.ts",
        "./src/*.tsx",
        "./src/*/index.ts",
        "./src/*/index.tsx"
      ],
      "types": [
        "./dist/*",
        "./dist/*.d.ts",
        "./dist/*/index.d.ts"
      ],
      "default": [
        "./src/*",
        "./src/*.ts",
        "./src/*.tsx",
        "./src/*/index.ts",
        "./src/*/index.tsx"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./internal/server": {
      "types": "./dist/server/internal.d.ts",
      "import": "./dist/server-internal.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./client/connection": {
      "types": "./dist/client/connection.d.ts",
      "import": "./dist/client-connection.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "vp test run",
    "lint": "vp lint .",
    "lint:fix": "vp lint --fix ."
  },
  "dependencies": {
    "@nanostores/preact": "1.1.1",
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@patchsmith/app-db": "workspace:*",
    "@standard-schema/spec": "^1.1.0",
    "nanostores": "1.5.5",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@patchsmith/config": "workspace:*",
    "@types/node": "catalog:",
    "happy-dom": "^21.0.3",
    "preact": "^11.0.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "preact": "^11.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
