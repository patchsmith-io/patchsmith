{
  "name": "@patchsmith/vite",
  "version": "0.1.0-beta.68",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patchsmith-io/patchsmith.git",
    "directory": "packages/vite"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#env": "./src/env.ts",
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./builder": {
      "types": "./dist/builder.d.mts",
      "import": "./dist/builder.mjs"
    },
    "./upload-manifest": {
      "types": "./dist/upload-manifest.d.mts",
      "import": "./dist/upload-manifest.mjs"
    },
    "./config": {
      "types": "./dist/config.d.mts",
      "import": "./dist/config.mjs"
    },
    "./config/app-link": {
      "types": "./dist/app-link.d.mts",
      "import": "./dist/app-link.mjs"
    },
    "./config/loader": {
      "types": "./dist/config-loader.d.mts",
      "import": "./dist/config-loader.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check-types": "tsc --noEmit",
    "test": "vp test run",
    "lint": "vp lint .",
    "lint:fix": "vp lint --fix ."
  },
  "dependencies": {
    "@patchsmith/app": "workspace:*",
    "cosmiconfig": "^10.0.1",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@patchsmith/asset-delivery": "workspace:*",
    "@patchsmith/config": "workspace:*",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "happy-dom": "^21.0.3",
    "preact": "^11.0.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "vite": "^8.0.0 || ^1.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
